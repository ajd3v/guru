{
  "name": "guru",
  "version": "1.0.0",
  "description": "A study companion for your own library that never misquotes: every claim is a verbatim quote, cited.",
  "scripts": {
    "test": "node test/run.ts",
    "serve": "node src/server.ts",
    "eval": "node eval/run.ts",
    "eval:compare": "node eval/compare.ts",
    "eval:gen": "node eval/generate.ts",
    "worker": "node src/cli.ts worker",
    "eval:answers": "node eval/answers.ts",
    "eval:rerank": "node eval/rerank.ts",
    "eval:pipeline": "node eval/pipeline.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajd3v/guru.git"
  },
  "keywords": [
    "rag",
    "citations",
    "sqlite",
    "retrieval",
    "embeddings",
    "llm"
  ],
  "author": "Alan Devaney",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/ajd3v/guru/issues"
  },
  "homepage": "https://github.com/ajd3v/guru#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@clerk/backend": "^3.13.2",
    "@huggingface/transformers": "^4.2.0",
    "better-sqlite3": "^13.0.1",
    "pdfjs-dist": "6.3.289",
    "sqlite-vec": "^0.1.9"
  },
  "bin": {
    "guru": "src/cli.ts"
  }
