# Copy to .env. Profile loading reads it before auth and storage initialize.
# No provider key is needed for plain ingest, Find, or local retrieval evaluation.

# The model provider. Set a base URL and the protocol is inferred: an OpenAI-compatible
# URL selects the OpenAI path, otherwise it talks Anthropic Messages. Any OpenAI-compatible
# endpoint works (DeepInfra, Together, OpenRouter, vLLM, LM Studio, a local router).
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
DEEPINFRA_API_KEY=

# Or Anthropic directly:
# ANTHROPIC_API_KEY=

# Model ids are protocol-specific, so the defaults differ per provider and both are optional.
# Leave them out rather than setting them empty. The pipeline model does query expansion,
# reranking and contextualising; the answer model writes the answer.
# GURU_PIPELINE_MODEL=
# GURU_ANSWER_MODEL=

# Which local embedder to index with. Changing it means rebuilding the corpus, since the
# vectors are not comparable across models. bge-base is the default and the measured choice.
# GURU_EMBED=bge-base

# Local hybrid retrieval. The profile supplies vectorWeight unless overridden here.
# GURU_VECTOR_WEIGHT=2
# GURU_CANDIDATES=60

# Where the library lives. One SQLite file per reader.
# GURU_DB=data/library.db

# Application profile and externally managed source library.
# GURU_PROFILE=guru.config.json
# GURU_STARTER_MODE=managed
# GURU_PYTHON=.venv/bin/python
